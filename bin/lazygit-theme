#!/usr/bin/env bash
# Regenerates ~/.config/lazygit/config.yml from configs/lazygit/settings.yml plus
# a theme derived from the current Omarchy palette.
#
# Omarchy themes every terminal app by shipping a per-app file, but there is no
# lazygit one. Every theme does ship colors.toml with the same semantic keys, so
# the theme is derived from those rather than pinned to any one palette: switch
# themes and this regenerates. Installed as a theme-set hook by bin/sync-omarchy.
#
# Run: bin/lazygit-theme
set -euo pipefail

SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  link_target="$(readlink "$SCRIPT")"
  case "$link_target" in
    /*) SCRIPT="$link_target" ;;
    *)  SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$link_target" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"

SETTINGS="$REPO_ROOT/configs/lazygit/settings.yml"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml"
COLORS="${OMARCHY_THEME_DIR:-$HOME/.local/state/omarchy/current/theme}/colors.toml"

[ -f "$SETTINGS" ] || { echo "✖ No settings at $SETTINGS" >&2; exit 1; }

# colors.toml is flat `key = "#rrggbb"`, so it is read directly rather than
# through a TOML parser this repo would otherwise not need.
color() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{3,8\}\)\".*/\1/p" "$COLORS" | head -1; }

# Falls back through the keys an older theme is most likely to have instead.
pick() {
  local key value
  for key in "$@"; do
    value="$(color "$key")"
    [ -n "$value" ] && { printf '%s' "$value"; return 0; }
  done
  return 1
}

if [ ! -f "$COLORS" ]; then
  # No Omarchy palette (a fresh machine before the first theme set, or macOS).
  # Ship the settings alone and let lazygit use its own colours rather than
  # writing a half-themed file.
  install -Dm644 "$SETTINGS" "$CONFIG"
  echo "→ lazygit: settings only, no Omarchy palette at $COLORS"
  exit 0
fi

accent="$(pick accent blue bright_blue)"
muted="$(pick muted dark_foreground lighter_background)"
selection="$(pick selection lighter_background dark_background)"
fg="$(pick foreground light_foreground)"

mkdir -p "$(dirname "$CONFIG")"
{
  echo "# Generated by bin/lazygit-theme -- edit configs/lazygit/settings.yml instead."
  echo "# Theme derived from $COLORS"
  cat "$SETTINGS"
  cat <<EOF
  theme:
    activeBorderColor:
      - "$accent"
    inactiveBorderColor:
      - "$muted"
    searchingActiveBorderColor:
      - "$accent"
    selectedLineBgColor:
      - "$selection"
    optionsTextColor:
      - "$muted"
    defaultFgColor:
      - "$fg"
EOF
} > "$CONFIG"

echo "→ lazygit theme: accent $accent, muted $muted, selection $selection"
