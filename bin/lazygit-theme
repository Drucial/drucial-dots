#!/usr/bin/env bash
# Regenerates ~/.config/lazygit/config.yml from configs/lazygit/settings.yml plus
# a theme derived from the current Omarchy palette.
#
# Omarchy themes every terminal app by shipping a per-app file, but there is no
# lazygit one. Every theme does ship colors.toml with the same semantic keys, so
# the theme is derived from those rather than pinned to any one palette: switch
# themes and this regenerates. Installed as a theme-set hook by bin/sync-omarchy.
#
# Without an Omarchy palette (macOS, or a fresh machine) the terminal is asked
# for its own background and foreground over OSC 11/10 and the theme is mixed
# between the two. That is a VT escape any modern terminal answers, so it needs
# no knowledge of which terminal is running or how it was themed, and the greys
# land in the background's own hue instead of fighting it. Falls back to a fixed
# grayscale ramp when there is no terminal to ask.
#
# Run: bin/lazygit-theme [--dark|--light] [--saturation N]
#   --dark/--light skip the query and force the fixed ramp.
#   --saturation is how hard the chrome carries the background's colour cast:
#   0 gives flat grey, 100 keeps the background's own, and the 180 default lifts
#   it enough to survive being lightened without reading as a colour of its own.
#   Env: LAZYGIT_THEME_MODE=auto|dark|light, LAZYGIT_THEME_SATURATION=N
set -euo pipefail

MODE="${LAZYGIT_THEME_MODE:-auto}"
SATURATION="${LAZYGIT_THEME_SATURATION:-180}"
while [ $# -gt 0 ]; do
  case "$1" in
    --auto)  MODE=auto ;;
    --dark)  MODE=dark ;;
    --light) MODE=light ;;
    --saturation) shift; SATURATION="${1:-}" ;;
    *) echo "✖ Unknown argument: $1" >&2; exit 1 ;;
  esac
  shift
done
case "$SATURATION" in
  ''|*[!0-9]*) echo "✖ Saturation must be a whole number: $SATURATION" >&2; exit 1 ;;
esac
case "$MODE" in
  auto|dark|light) ;;
  *) echo "✖ Unknown mode: $MODE (expected auto, dark or light)" >&2; exit 1 ;;
esac

SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  link_target="$(readlink "$SCRIPT")"
  case "$link_target" in
    /*) SCRIPT="$link_target" ;;
    *)  SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$link_target" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"

SETTINGS="$REPO_ROOT/configs/lazygit/settings.yml"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml"
COLORS="${OMARCHY_THEME_DIR:-$HOME/.local/state/omarchy/current/theme}/colors.toml"

[ -f "$SETTINGS" ] || { echo "✖ No settings at $SETTINGS" >&2; exit 1; }

# colors.toml is flat `key = "#rrggbb"`, so it is read directly rather than
# through a TOML parser this repo would otherwise not need.
color() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{3,8\}\)\".*/\1/p" "$COLORS" | head -1; }

# Falls back through the keys an older theme is most likely to have instead.
pick() {
  local key value
  for key in "$@"; do
    value="$(color "$key")"
    [ -n "$value" ] && { printf '%s' "$value"; return 0; }
  done
  return 1
}

# Asks the terminal for one of its own colours: OSC 10 is the foreground, OSC 11
# the background. The reply comes back on the same tty as `rgb:rrrr/gggg/bbbb`
# with 1-4 hex digits per channel, so each is padded out and truncated to 8-bit.
# `min 0 time 3` caps the wait at 0.3s, which is what keeps a terminal that
# ignores the query from hanging the script.
query_terminal_color() {
  local code="$1" saved reply
  # Braced so bash's own message for a failed redirect is suppressed too.
  { exec 3<>/dev/tty; } 2>/dev/null || return 1
  saved="$(stty -g <&3 2>/dev/null)" || { exec 3>&-; return 1; }
  stty raw -echo min 0 time 3 <&3 2>/dev/null || { exec 3>&-; return 1; }
  printf '\033]%s;?\007' "$code" >&3
  reply="$(dd bs=64 count=1 <&3 2>/dev/null)" || true
  stty "$saved" <&3 2>/dev/null || true
  exec 3>&-

  [[ "$reply" =~ rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4}) ]] || return 1
  local channel out=""
  for channel in "${BASH_REMATCH[@]:1:3}"; do
    channel="${channel}${channel}${channel}${channel}"
    out="$out${channel:0:2}"
  done
  printf '#%s' "$out"
}

clamp() {
  local v="$1"
  [ "$v" -lt 0 ] && v=0
  [ "$v" -gt 255 ] && v=255
  printf '%d' "$v"
}

# A shade `level` percent of the way from the background's brightness toward the
# foreground's, carrying the background's own colour cast at $SATURATION.
#
# Interpolating straight from bg to fg would be the obvious thing, but it averages
# the two casts against each other and the middle of the ramp comes out grey --
# which on a tinted background reads as dirt. So brightness alone is interpolated,
# and each channel's distance from its own average (the cast) is re-applied on
# top, amplified: backgrounds are usually desaturated, and a cast that survives at
# background brightness disappears once lightened. A neutral grey background has
# no cast to amplify and stays grey.
tint() {
  local level="$1"
  local br=$((16#${bg:1:2}))       bgr=$((16#${bg:3:2}))       bb=$((16#${bg:5:2}))
  local fr=$((16#${term_fg:1:2}))  fgr=$((16#${term_fg:3:2}))  fb=$((16#${term_fg:5:2}))
  local bmean=$(( (br + bgr + bb) / 3 ))
  local fmean=$(( (fr + fgr + fb) / 3 ))
  local target=$(( bmean + (fmean - bmean) * level / 100 ))
  printf '#%02x%02x%02x' \
    "$(clamp $(( target + (br  - bmean) * SATURATION / 100 )))" \
    "$(clamp $(( target + (bgr - bmean) * SATURATION / 100 )))" \
    "$(clamp $(( target + (bb  - bmean) * SATURATION / 100 )))"
}

if [ ! -f "$COLORS" ]; then
  # No Omarchy palette (a fresh machine before the first theme set, or macOS).
  # Every one of lazygit's twelve theme keys is set so nothing falls through to
  # its ANSI defaults, which are at the mercy of the terminal's own palette.
  bg=""; term_fg=""
  if [ "$MODE" = auto ]; then
    bg="$(query_terminal_color 11 || true)"
    term_fg="$(query_terminal_color 10 || true)"
    [ "$bg" = "$term_fg" ] && { bg=""; term_fg=""; }
  fi

  if [ -n "$bg" ] && [ -n "$term_fg" ]; then
    # One ramp off the terminal's background. Nothing here picks a hue; it only
    # carries the background's own, so the chrome reads as part of the theme.
    source="terminal $bg → $term_fg at ${SATURATION}% cast"
    fg="$term_fg"
    insel_bg="$(tint 6)"
    sel_bg="$(tint 13)"
    inactive="$(tint 26)"
    cherry_bg="$(tint 40)"
    options="$(tint 44)"
    author="$(tint 50)"
    marked_bg="$(tint 56)"
    unstaged="$(tint 64)"
    active="$(tint 72)"
    cherry_fg="$bg"
    marked_fg="$bg"
  elif [ "$MODE" = light ]; then
    source="fixed light ramp"
    fg="#2e2e2e";        active="#101010";    inactive="#bcbcbc"
    options="#8a8a8a";   sel_bg="#e2e2e2";    insel_bg="#ededed"
    cherry_fg="#fafafa"; cherry_bg="#5a5a5a"
    marked_fg="#fafafa"; marked_bg="#8c8c8c"
    unstaged="#5c5c5c";  author="#6e6e6e"
  else
    source="fixed dark ramp"
    fg="#c6c6c6";        active="#e4e4e4";    inactive="#4c4c4c"
    options="#767676";   sel_bg="#303030";    insel_bg="#262626"
    cherry_fg="#1c1c1c"; cherry_bg="#9e9e9e"
    marked_fg="#1c1c1c"; marked_bg="#6c6c6c"
    unstaged="#a8a8a8";  author="#8c8c8c"
  fi

  mkdir -p "$(dirname "$CONFIG")"
  {
    echo "# Generated by bin/lazygit-theme -- edit configs/lazygit/settings.yml instead."
    echo "# Neutral theme from $source: no Omarchy palette at $COLORS"
    cat "$SETTINGS"
    cat <<EOF
  authorColors:
    "*": "$author"
  theme:
    activeBorderColor:
      - "$active"
    inactiveBorderColor:
      - "$inactive"
    searchingActiveBorderColor:
      - "$active"
      - bold
    optionsTextColor:
      - "$options"
    selectedLineBgColor:
      - "$sel_bg"
    inactiveViewSelectedLineBgColor:
      - "$insel_bg"
    cherryPickedCommitFgColor:
      - "$cherry_fg"
    cherryPickedCommitBgColor:
      - "$cherry_bg"
    markedBaseCommitFgColor:
      - "$marked_fg"
    markedBaseCommitBgColor:
      - "$marked_bg"
    unstagedChangesColor:
      - "$unstaged"
    defaultFgColor:
      - "$fg"
EOF
  } > "$CONFIG"

  echo "→ lazygit theme: neutral, $source"
  exit 0
fi

accent="$(pick accent blue bright_blue)"
muted="$(pick muted dark_foreground lighter_background)"
selection="$(pick selection lighter_background dark_background)"
fg="$(pick foreground light_foreground)"

mkdir -p "$(dirname "$CONFIG")"
{
  echo "# Generated by bin/lazygit-theme -- edit configs/lazygit/settings.yml instead."
  echo "# Theme derived from $COLORS"
  cat "$SETTINGS"
  cat <<EOF
  theme:
    activeBorderColor:
      - "$accent"
    inactiveBorderColor:
      - "$muted"
    searchingActiveBorderColor:
      - "$accent"
    selectedLineBgColor:
      - "$selection"
    optionsTextColor:
      - "$muted"
    defaultFgColor:
      - "$fg"
EOF
} > "$CONFIG"

echo "→ lazygit theme: accent $accent, muted $muted, selection $selection"
