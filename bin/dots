#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/dots <command> [options] [args]

Commands:
  install              Link every config into ~/.config, plus home-level dotfiles
  add <name>           Scaffold a new config in the repo and link it out
  migrate <name>...    Adopt existing ~/.config/<name> into the repo, link it back
  remove <name>        Unlink, delete from the repo, offer to drop its packages
  brew [-c]            Install the root Brewfile; -c checks it instead
  pac [-c]             Install the root Archfile with yay; -c checks it instead

Options (place before positional args):
  -f   Force: replace existing links and drifted files. Never touches directories.
  -n   Dry-run: print what would happen, change nothing
  -v   Verbose
  -y   remove: skip the confirmation prompt
  -h   Help

Configs live in configs/ and are symlinked out, never copied. Packages live in
two manifests -- Brewfile for macOS, Archfile for Omarchy -- under
`# --- config: <name> ---` sections, which add, migrate, and remove maintain in
both. Every command reports a summary and exits non-zero if anything was left
unresolved.
EOF
}

# --- Resolve repo root from THIS script's location (follow symlinks) ---
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  link_target="$(readlink "$SCRIPT")"
  case "$link_target" in
    /*) SCRIPT="$link_target" ;;
    *)  SCRIPT="$(cd "$(dirname "$SCRIPT")" && pwd)/$link_target" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"
CONFIGS="$REPO_ROOT/configs"
BREWFILE="$REPO_ROOT/Brewfile"
ARCHFILE="$REPO_ROOT/Archfile"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

# Targets outside $CONFIG_DIR, as dst::src. Sources point at the repo, so these
# don't depend on the ~/.config links existing first.
HOME_LINKS=(
  "$HOME/.zshrc::$CONFIGS/zsh/.zshrc"
  "$HOME/.zprofile::$CONFIGS/zsh/.zprofile"
  "$HOME/.bashrc::$CONFIGS/bash/.bashrc"
  "$HOME/.bash_aliases::$CONFIGS/bash/.bash_aliases"
)

# NoDisplay overrides that hide menu entries belonging to packages that cannot
# be uninstalled, because half the desktop depends on them. Same basename as the
# entry in /usr/share/applications, which is what shadows it. Linked one file at
# a time: the directory also holds web app launchers that Omarchy writes itself.
APPS_DIR="$HOME/.local/share/applications"
for entry in "$REPO_ROOT/desktop-entries"/*.desktop; do
  [ -e "$entry" ] || continue
  HOME_LINKS+=("$APPS_DIR/$(basename "$entry")::$entry")
done

# One per platform, as path::label. add and migrate open a section in every one
# so a config stays addressable from whichever machine runs remove later.
MANIFESTS=(
  "$BREWFILE::Brewfile"
  "$ARCHFILE::Archfile"
)

force=false
dryrun=false
verbose=false
assume_yes=false
check_only=false

LINKED=()
OK=()
FAILED=()

msg(){ $verbose && echo "$@" || true; }
section(){ echo; echo "▶ $*"; }
die(){ echo "✖ $*" >&2; exit 1; }
tilde(){ local t='~'; echo "${1/#$HOME/$t}"; }

# Record a conflict: destination, what's in the way, how to resolve it.
fail(){ FAILED+=("$1"$'\t'"$2"$'\t'"$3"); }

# 1. Linking -------------------------------------------------------------------

# Symlink $1 -> $2. Idempotent, and never aborts the caller's loop: conflicts
# are recorded for the summary rather than raised.
link_path() {
  local src="$1" dst="$2"
  if [ ! -e "$src" ]; then
    fail "$dst" "source missing: $(tilde "$src")" "nothing in the repo to link here"
    return 0
  fi
  # Compare inodes, not readlink strings — a case-insensitive filesystem hands
  # back the path as it was typed, so /Users/x/dev and /Users/x/Dev both resolve.
  if [ -e "$dst" ] && [ "$dst" -ef "$src" ]; then
    OK+=("$dst")
    msg "✓ Already linked: $(tilde "$dst")"
    return 0
  fi
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if [ -d "$dst" ] && [ ! -L "$dst" ]; then
      fail "$dst" "a real directory, not a link" \
        "bin/dots migrate $(basename "$dst")   adopt it into the repo"
      return 0
    fi
    if ! $force; then
      if [ -L "$dst" ]; then
        fail "$dst" "symlink to $(readlink "$dst")" "bin/dots install -f   replaces links"
      else
        fail "$dst" "a real file, not a link — an app wrote it in place" \
          "diff it against $(tilde "$src"), then bin/dots install -f (no backup)"
      fi
      return 0
    fi
    # -f overwrites with no backup, and a real file here holds the only copy of
    # whatever drifted into it.
    [ -L "$dst" ] || echo "⚠ Overwriting a real file: $(tilde "$dst")" >&2
  fi
  if $dryrun; then
    echo "DRY-RUN: ln -sfn \"$src\" \"$dst\""
    LINKED+=("$dst")
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$src" "$dst"
  LINKED+=("$dst")
  msg "→ Linked: $(tilde "$dst")"
}

summary() {
  section "Summary"
  printf '  Linked      %3d\n' "${#LINKED[@]}"
  printf '  Already ok  %3d\n' "${#OK[@]}"
  printf '  Unresolved  %3d\n' "${#FAILED[@]}"
  if [ "${#FAILED[@]}" -eq 0 ]; then
    echo
    echo "✓ Done."
    return 0
  fi
  echo
  echo "  Unresolved — nothing at these paths was changed:"
  local entry dst reason remedy
  for entry in "${FAILED[@]}"; do
    IFS=$'\t' read -r dst reason remedy <<< "$entry"
    echo
    echo "    ✖ $(tilde "$dst")"
    echo "      $reason"
    echo "      $remedy"
  done
  echo
  return 1
}

# 2. Package manifests ---------------------------------------------------------

# Both manifests share one grammar: a `# --- config: <name> ---` marker owns
# every line up to the next `# --- ` marker. Each helper takes the file to act on.

manifest_has_section(){ grep -qxF "# --- config: $2 ---" "$1"; }

manifest_section_body() {
  awk -v n="$2" '$0=="# --- config: "n" ---"{f=1;next} /^# --- /{f=0} f' "$1"
}

# Insert a section above the review block if there is one, else at the end.
manifest_add_section() {
  local file="$1" name="$2" body="${3:-}" block tmp
  block="# --- config: $name ---"
  if [ -n "$body" ]; then block="$block"$'\n'"$body"; fi
  tmp="$(mktemp)"
  # Passed through the environment, not -v: awk rejects a newline in a -v value.
  BLOCK="$block" awk '
    /^# --- review ---$/ && !placed { print ENVIRON["BLOCK"]; print ""; placed=1 }
    { print }
    END { if (!placed) { print ""; print ENVIRON["BLOCK"] } }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

manifest_drop_section() {
  local tmp
  tmp="$(mktemp)"
  awk -v n="$2" '
    $0=="# --- config: "n" ---" { f=1; next }
    /^# --- / { f=0 }
    !f { print }
  ' "$1" > "$tmp"
  mv "$tmp" "$1"
}

# What a new section starts with, asked of the platform's package manager. A name
# it doesn't know yields an empty section, which is the prompt to fill it by hand.
brew_seed() {
  command -v brew >/dev/null 2>&1 || return 0
  if brew info --formula "$1" >/dev/null 2>&1; then
    echo "brew \"$1\""
  elif brew info --cask "$1" >/dev/null 2>&1; then
    echo "cask \"$1\""
  fi
}

# pacman's local sync db only. Reaching the AUR needs the network and is slow
# enough to stall `add`.
pac_seed() {
  command -v pacman >/dev/null 2>&1 || return 0
  pacman -Si "$1" >/dev/null 2>&1 && echo "$1"
}

register_section() {
  local file="$1" label="$2" name="$3" body="$4"
  if manifest_has_section "$file" "$name"; then
    msg "✓ $label section exists: $name"
    return 0
  fi
  if $dryrun; then
    echo "DRY-RUN: add $label section for $name"
    return 0
  fi
  manifest_add_section "$file" "$name" "$body"
  if [ -n "$body" ]; then
    echo "→ $label: added section $name, seeded $body"
  else
    echo "→ $label: added empty section $name — put its packages there"
  fi
}

# Give a config a section in every manifest, seeded where the name resolves.
register_packages() {
  local name="$1"
  register_section "$BREWFILE" Brewfile "$name" "$(brew_seed "$name")"
  register_section "$ARCHFILE" Archfile "$name" "$(pac_seed "$name")"
}

# Show what every manifest gives the config, then drop it from all of them on one
# confirmation. Nothing is uninstalled — this only edits the files.
drop_sections() {
  local name="$1" pair file label body reply found=false
  for pair in "${MANIFESTS[@]}"; do
    file="${pair%%::*}"; label="${pair##*::}"
    if ! manifest_has_section "$file" "$name"; then
      echo "✓ No $label section for $name"
      continue
    fi
    found=true
    if $dryrun; then
      echo "DRY-RUN: drop $label section $name"
      continue
    fi
    body="$(manifest_section_body "$file" "$name" | sed '/^[[:space:]]*$/d')"
    echo
    echo "  $label section \`$name\` owns:"
    if [ -n "$body" ]; then echo "$body" | sed 's/^/    /'; else echo "    (nothing)"; fi
  done
  { $found && ! $dryrun; } || return 0

  echo "  Nothing is uninstalled — this only edits the manifests."
  if $assume_yes; then
    reply=y
  else
    read -r -p "  Drop the sections? [y/N] " reply || reply=n
  fi
  case "$reply" in
    [yY]*) ;;
    *) echo "✓ Sections kept"; return 0 ;;
  esac
  for pair in "${MANIFESTS[@]}"; do
    file="${pair%%::*}"; label="${pair##*::}"
    manifest_has_section "$file" "$name" || continue
    manifest_drop_section "$file" "$name"
    echo "→ $label: dropped section $name"
  done
}

# 3. Commands ------------------------------------------------------------------

cmd_install() {
  local src pair rc=0
  section "Configs → $(tilde "$CONFIG_DIR")"
  for src in "$CONFIGS"/*; do
    link_path "$src" "$CONFIG_DIR/$(basename "$src")"
  done
  section "Home symlinks"
  for pair in "${HOME_LINKS[@]}"; do
    link_path "${pair##*::}" "${pair%%::*}"
  done
  summary || rc=1
  if command -v pacman >/dev/null 2>&1; then
    echo "  Packages are separate — run \`bin/dots pac\` to install them."
  else
    echo "  Packages are separate — run \`bin/dots brew\` to install them."
  fi
  return $rc
}

cmd_add() {
  local name="${1:-}"
  [ -n "$name" ] || die "add: needs a config name"
  [ ! -e "$CONFIGS/$name" ] || die "configs/$name already exists — \`bin/dots install\` links it."
  if [ -e "$CONFIG_DIR/$name" ] || [ -L "$CONFIG_DIR/$name" ]; then
    die "$(tilde "$CONFIG_DIR/$name") already exists — \`bin/dots migrate $name\` adopts it."
  fi
  section "Add $name"
  if $dryrun; then
    echo "DRY-RUN: mkdir -p \"$CONFIGS/$name\""
  else
    mkdir -p "$CONFIGS/$name"
    echo "→ Created: configs/$name"
  fi
  link_path "$CONFIGS/$name" "$CONFIG_DIR/$name"
  register_packages "$name"
  summary
}

cmd_migrate() {
  [ $# -gt 0 ] || die "migrate: needs one or more config names"
  section "Migrate → configs/"
  local name src dst
  for name in "$@"; do
    src="$CONFIG_DIR/$name"
    dst="$CONFIGS/$name"
    if [ -L "$src" ]; then
      # Already migrated. Re-check the Brewfile section so a run that died
      # partway can be resumed.
      if [ "$src" -ef "$dst" ]; then
        OK+=("$src")
        register_packages "$name"
        continue
      fi
      fail "$src" "a symlink to $(readlink "$src"), outside this repo" "resolve it by hand"
      continue
    fi
    if [ ! -e "$src" ]; then
      fail "$src" "no such path" "check the name, or \`bin/dots add $name\` to start fresh"
      continue
    fi
    if [ -e "$dst" ]; then
      fail "$src" "configs/$name already exists in the repo" "diff the two and remove one side"
      continue
    fi
    if $dryrun; then
      echo "DRY-RUN: mv \"$src\" \"$dst\" && ln -s \"$dst\" \"$src\""
      LINKED+=("$src")
      register_packages "$name"
      continue
    fi
    mv "$src" "$dst"
    echo "→ Moved into repo: configs/$name"
    link_path "$dst" "$src"
    register_packages "$name"
  done
  summary
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "remove: needs a config name"
  local link="$CONFIG_DIR/$name" dir="$CONFIGS/$name" body reply
  section "Remove $name"

  if [ -L "$link" ]; then
    if [ ! "$link" -ef "$dir" ]; then
      die "$(tilde "$link") points outside this repo ($(readlink "$link")). Remove it by hand."
    fi
    if $dryrun; then
      echo "DRY-RUN: rm \"$link\""
    else
      rm "$link"
      echo "→ Unlinked: $(tilde "$link")"
    fi
  elif [ -e "$link" ]; then
    die "$(tilde "$link") is a real path, not a link into this repo. Remove it by hand."
  else
    echo "✓ Nothing linked at $(tilde "$link")"
  fi

  if [ ! -e "$dir" ]; then
    echo "✓ No configs/$name in the repo"
  elif $dryrun; then
    echo "DRY-RUN: git rm -r \"configs/$name\""
  elif [ -n "$(git -C "$REPO_ROOT" ls-files -- "$dir")" ]; then
    git -C "$REPO_ROOT" rm -rq "$dir"
    echo "→ git rm: configs/$name"
  else
    rm -r -f -- "$dir"
    echo "→ Deleted (untracked): configs/$name"
  fi

  drop_sections "$name"
}

cmd_brew() {
  section "Packages"
  if $check_only; then
    brew_check
    return $?
  fi
  if ! command -v brew >/dev/null 2>&1; then
    echo "⚠ Homebrew not found — skipping. Configs link fine without it."
    return 0
  fi
  if $dryrun; then
    brew bundle check --file="$BREWFILE" --verbose --no-upgrade || true
  else
    brew bundle install --file="$BREWFILE" --no-upgrade
  fi
}

# Cross-check configs/ against one manifest's section markers.
manifest_check_sections() {
  local file="$1" label="$2" rc=0 name src missing=() orphan=()
  for src in "$CONFIGS"/*; do
    name="$(basename "$src")"
    manifest_has_section "$file" "$name" || missing+=("$name")
  done
  while IFS= read -r name; do
    [ -e "$CONFIGS/$name" ] || orphan+=("$name")
  done < <(sed -n 's/^# --- config: \(.*\) ---$/\1/p' "$file")

  # Not an error — some configs genuinely install nothing. Listed so an
  # unexpected name is visible.
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "· Configs that declare no packages:"
    printf '    %s\n' "${missing[@]}"
  fi
  if [ "${#orphan[@]}" -gt 0 ]; then
    rc=1
    echo "✖ $label sections with no config:"
    printf '    %s\n' "${orphan[@]}"
    echo "  Drop them, or run \`bin/dots add <name>\`."
  else
    echo "✓ Every $label section has a config."
  fi
  return $rc
}

# Ask Homebrew whether the Brewfile is satisfied.
brew_check() {
  local rc=0
  manifest_check_sections "$BREWFILE" Brewfile || rc=1
  echo
  if command -v brew >/dev/null 2>&1; then
    brew bundle check --file="$BREWFILE" --verbose --no-upgrade || rc=1
  else
    echo "⚠ Homebrew not found — package check skipped."
  fi
  return $rc
}

# Package names from the Archfile: one per line, comments and blanks dropped.
arch_packages() {
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$ARCHFILE" | grep -v '^$'
}

cmd_pac() {
  local pkg pkgs=()
  section "Packages"
  if $check_only; then
    pac_check
    return $?
  fi
  if ! command -v yay >/dev/null 2>&1; then
    echo "⚠ yay not found — skipping. Configs link fine without it."
    return 0
  fi
  while IFS= read -r pkg; do pkgs+=("$pkg"); done < <(arch_packages)
  if [ "${#pkgs[@]}" -eq 0 ]; then
    echo "✓ Archfile names no packages."
    return 0
  fi
  if $dryrun; then
    echo "DRY-RUN: yay -S --needed ${pkgs[*]}"
    return 0
  fi
  yay -S --needed "${pkgs[@]}"
}

# Cross-check configs/ against the Archfile, then ask pacman which of the names
# it lists are not installed.
pac_check() {
  local rc=0 pkg missing=()
  manifest_check_sections "$ARCHFILE" Archfile || rc=1
  echo
  if ! command -v pacman >/dev/null 2>&1; then
    echo "⚠ pacman not found — package check skipped."
    return $rc
  fi
  while IFS= read -r pkg; do
    pacman -Qq "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done < <(arch_packages)
  if [ "${#missing[@]}" -gt 0 ]; then
    rc=1
    echo "✖ Archfile packages not installed:"
    printf '    %s\n' "${missing[@]}"
    echo "  Install them with \`bin/dots pac\`."
  else
    echo "✓ Every Archfile package is installed."
  fi
  return $rc
}

# 4. Dispatch ------------------------------------------------------------------

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  install|add|migrate|remove|brew|pac) ;;
  ""|-h|--help|help) usage; exit 0 ;;
  *) echo "✖ Unknown command: $cmd" >&2; echo >&2; usage >&2; exit 2 ;;
esac

# getopts stops at the first positional, so alternate between it and collecting
# args — `remove foo -y` has to work, not just `remove -y foo`.
positional=()
while [ $# -gt 0 ]; do
  OPTIND=1
  while getopts ":fnvych" opt; do
    case "$opt" in
      f) force=true ;;
      n) dryrun=true ;;
      v) verbose=true ;;
      y) assume_yes=true ;;
      c) check_only=true ;;
      h) usage; exit 0 ;;
      \?) echo "✖ Unknown option: -$OPTARG" >&2; exit 2 ;;
    esac
  done
  shift $((OPTIND - 1))
  if [ $# -gt 0 ]; then
    positional+=("$1")
    shift
  fi
done
set -- ${positional[@]+"${positional[@]}"}

"cmd_$cmd" "$@"
