# Aliases shared by bash and zsh.

alias c='clear'
alias x='exit'
alias e='nvim'
alias gg='lazygit'
alias cc='claude'
alias ~='cd ~'

if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias eff='$EDITOR "$(ff)"'

command -v zoxide &> /dev/null && alias cd='zd'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

alias zn='zen-notes'
alias zr='zen-review'
alias zo='zen-octo'
alias zl='zen-linear'
alias zs='zen-stats'

# Edits go through chezmoi so the repo, not just this machine, gets the change.
if [ -n "$ZSH_VERSION" ]; then
  alias src='source ~/.zshrc'
  alias zshrc='chezmoi edit --apply ~/.zshrc'
else
  alias src='source ~/.bashrc'
  alias bashrc='chezmoi edit --apply ~/.bashrc'
fi

alias fs='fzf --ansi --disabled --delimiter : --bind "start:reload:rg --column --line-number --no-heading --color=always --smart-case {q}" --bind "change:reload:sleep 0.1; rg --column --line-number --no-heading --color=always --smart-case {q} || true" --preview "bat --style=numbers --color=always --highlight-line {2} {1}" --bind "enter:become(nvim +{2} {1})"'

{{ if eq .chezmoi.os "darwin" -}}
alias ip='ipconfig getifaddr en0 | tee >(pbcopy)'
{{- else -}}
alias ip='ip -4 -o addr show scope global | awk "{print \$4}" | cut -d/ -f1 | head -1 | tee >(wl-copy)'
{{- end }}
