{
  "id": "root",
  "cloned_from": {
    "name": "Zen",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "zen-lab-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "zen-lab-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "prs",
              "type": "block",
              "content": {
                "mod": "zen-lab-prs"
              },
              "size": {
                "px": 46
              },
              "min": 46
            }
          ]
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "floats",
          "type": "block",
          "content": {
            "mod": "drucial-floats"
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "focus-ring",
          "type": "block",
          "content": {
            "mod": "zen-focus"
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "chrome",
  "theme": "omarchy-zen",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
