# Before omarchy.zsh, which runs compinit.
FPATH=~/.rbenv/completions:"$FPATH"

source ~/.config/zsh/omarchy.zsh
source ~/.config/shell/aliases
source ~/.config/shell/functions

[ -f ~/.config/zsh/.secrets ] && source ~/.config/zsh/.secrets

export XDG_CONFIG_HOME="$HOME/.config"
export RAINFROG_CONFIG="$XDG_CONFIG_HOME/rainfrog"
# Stops sharp (Node image lib) from linking a Homebrew libvips it wasn't built against.
export SHARP_IGNORE_GLOBAL_LIBVIPS=1

case ":$PATH:" in
  *":$HOME/bin:"*) ;;
  *) export PATH="$HOME/bin:$PATH" ;;
esac

export FZF_DEFAULT_OPTS="
  --style=full
  --layout=reverse
  --color=16
  --height=100%
  --margin='1,2'
  --preview='bat --style=numbers --color=always {} | head -100'
"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --no-ignore --exclude .git --exclude node_modules --exclude build --exclude dist --exclude .next --exclude coverage'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

eval "$(rbenv init - --no-rehash zsh)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"

command -v atuin &> /dev/null && eval "$(atuin init zsh)"

# Loaded last: syntax highlighting must wrap every widget defined before it.
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
