#!/usr/bin/env bash
# Runs lazygit with a neutral theme derived from the terminal's own background and foreground.
set -euo pipefail

SATURATION="${LAZYGIT_THEME_SATURATION:-180}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit"
SETTINGS="$CONFIG_DIR/config.yml"
THEME="$CONFIG_DIR/theme.yml"

# OSC 10/11 reply is rgb:rrrr/gggg/bbbb with 1-4 hex digits per channel; `time 3` caps the wait at 0.3s for terminals that never answer.
query_terminal_color() {
  local code="$1" saved reply channel out=""
  { exec 3<>/dev/tty; } 2>/dev/null || return 1
  saved="$(stty -g <&3 2>/dev/null)" || { exec 3>&-; return 1; }
  stty raw -echo min 0 time 3 <&3 2>/dev/null || { exec 3>&-; return 1; }
  printf '\033]%s;?\007' "$code" >&3
  reply="$(dd bs=64 count=1 <&3 2>/dev/null)" || true
  stty "$saved" <&3 2>/dev/null || true
  exec 3>&-
  [[ "$reply" =~ rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4}) ]] || return 1
  for channel in "${BASH_REMATCH[@]:1:3}"; do
    channel="${channel}${channel}${channel}${channel}"
    out="$out${channel:0:2}"
  done
  printf '#%s' "$out"
}

clamp() {
  local v="$1"
  [ "$v" -lt 0 ] && v=0
  [ "$v" -gt 255 ] && v=255
  printf '%d' "$v"
}

# Interpolates brightness only and re-applies the background's colour cast amplified, since a straight bg→fg blend averages the cast to grey.
tint() {
  local level="$1" cast="${2:-$SATURATION}"
  local br=$((16#${bg:1:2})) bgr=$((16#${bg:3:2})) bb=$((16#${bg:5:2}))
  local fr=$((16#${fg:1:2})) fgr=$((16#${fg:3:2})) fb=$((16#${fg:5:2}))
  local bmean=$(( (br + bgr + bb) / 3 ))
  local fmean=$(( (fr + fgr + fb) / 3 ))
  local target=$(( bmean + (fmean - bmean) * level / 100 ))
  printf '#%02x%02x%02x' \
    "$(clamp $(( target + (br  - bmean) * cast / 100 )))" \
    "$(clamp $(( target + (bgr - bmean) * cast / 100 )))" \
    "$(clamp $(( target + (bb  - bmean) * cast / 100 )))"
}

write_theme() {
  local stamp="# derived: bg=$bg fg=$fg cast=$SATURATION"
  [ -f "$THEME" ] && grep -qxF "$stamp" "$THEME" && return 0
  mkdir -p "$CONFIG_DIR"
  cat > "$THEME" <<EOF
# Generated by lazygit-themed for this terminal's colours; not tracked.
$stamp
gui:
  authorColors:
    "*": "$(tint 54)"
  theme:
    activeBorderColor: ["$(tint 72)"]
    inactiveBorderColor: ["$(tint 32)"]
    searchingActiveBorderColor: ["$(tint 72)", bold]
    optionsTextColor: ["$(tint 56)"]
    selectedLineBgColor: ["$(tint 13 100)"]
    inactiveViewSelectedLineBgColor: ["$(tint 6 100)"]
    cherryPickedCommitFgColor: ["$bg"]
    cherryPickedCommitBgColor: ["$(tint 40)"]
    markedBaseCommitFgColor: ["$bg"]
    markedBaseCommitBgColor: ["$(tint 56)"]
    unstagedChangesColor: ["$(tint 64)"]
    defaultFgColor: ["$fg"]
EOF
}

bg="$(query_terminal_color 11 || true)"
fg="$(query_terminal_color 10 || true)"
if [ -n "$bg" ] && [ -n "$fg" ] && [ "$bg" != "$fg" ]; then
  write_theme
fi

if [ -f "$SETTINGS" ] && [ -f "$THEME" ]; then
  LG_CONFIG_FILE="$SETTINGS,$THEME" exec lazygit "$@"
fi
exec lazygit "$@"
