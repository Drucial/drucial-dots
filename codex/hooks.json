{
  "description": "Personal Claude-parity safeguards and workflow context for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/session-start.sh",
            "timeout": 5,
            "statusMessage": "Loading project context..."
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh SessionStart",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/protect-files.sh",
            "timeout": 5,
            "statusMessage": "Checking file protections..."
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/warn-large-files.sh",
            "timeout": 5,
            "statusMessage": "Checking for build artifacts..."
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/scan-secrets.sh",
            "timeout": 5,
            "statusMessage": "Scanning for secrets..."
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/check-primitives.sh",
            "timeout": 5,
            "statusMessage": "Checking for existing primitives..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/block-dangerous-commands.sh",
            "timeout": 5,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh PermissionRequest",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/format-on-save.sh",
            "timeout": 15,
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/nudge-duplication.sh",
            "timeout": 5,
            "statusMessage": "Scanning for duplication..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh Stop",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/kitty-agent-state.sh SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
