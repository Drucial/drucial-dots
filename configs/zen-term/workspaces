# zen-term workspaces — the ⌘⇧P project list.
# See docs/config/workspaces in the repo for the full field reference.

[ZenTerm]
path   = ~/Dev/zen-term
main   = claude
carry  = Sources/TerminalKit/Resources/ghostty-resources
carry  = Frameworks/GhosttyKit.xcframework

[Zen Linear]
path   = ~/Dev/zen-linear

tab
  main   = claude

tab
  main   = zen-linear

[Zen Octo]
path   = ~/Dev/zen-octo
main   = claude

[Zen Review]
path   = ~/Dev/zen-review
main   = claude

[Zen Notes]
path   = ~/Dev/zen-notes
main   = claude
right  = zen-notes

[Craftwork]
path   = ~/Dev/craftwork
carry  = .env.local
carry  = apps/rails/.overmind.env.local
carry  = apps/rails/config/credentials/development.key
carry  = apps/rails/config/credentials/production.key

tab
  main   = claude

tab = server

[Cohaus]
path   = ~/Dev/cohaus
carry  = .env.local
carry  = apps/mobile-app/.env.local

tab
  main   = claude

tab = server

[ZenTerm Website]
path   = ~/Dev/zen-term-website

tab
  main   = claude

tab = server

[Praxis-Labs]
path   = ~/Dev/praxis-labs

tab
  main   = Claude

tab = server

[Dot Files]
path   = ~/Dev/drucial-dots

tab
  main   = claude

tab
  main   = nvim

[Agent Kit]
path   = ~/Dev/agent-kit

tab
  main   = claude

tab
  main   = nvim

[Zen YouTube]
path   = ~/Dev/zen-youtube
main   = Claude

[Drucial.dev]
path   = ~/Dev/drucial-dot-dev
carry  = .env.local
carry  = node_modules

tab
  main   = claude

tab = server
