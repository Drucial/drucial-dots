# zen-term workspaces — the ⌘⇧P project list.
# See docs/config/workspaces in the repo for the full field reference.

[ZenTerm]
path   = ~/Dev/zen-term
main   = claude
carry  = Sources/TerminalKit/Resources/ghostty-resources

[Zen Linear]
path   = ~/Dev/zen-linear
main   = claude

[Zen Octo]
path   = ~/Dev/zen-octo
main   = claude

[Zen Review]
path   = ~/Dev/zen-review
main   = claude

[Zen Notes]
path   = ~/Dev/zen-notes
main   = claude
right  = zen-notes

[Craftwork]
path   = ~/Dev/craftwork
main   = nvim
right  = claude
bottom = shell
carry  = .env.local
carry  = apps/rails/.overmind.env.local
carry  = apps/rails/config/credentials/development.key
carry  = apps/rails/config/credentials/production.key

[Cohaus]
path   = ~/Dev/cohaus
main   = claude
carry  = .env.local
carry  = apps/mobile-app/.env.local

[ZenTerm Website]
path   = ~/Dev/zen-term-website
main   = nvim
right  = claude
bottom = "pnpm dev"
focus  = right

[Praxis-Labs]
path   = ~/Dev/praxis-labs
main   = Claude

[Drucial App]
path   = ~/Dev/drucial-app
main   = claude

[Dot Files]
path   = ~/Dev/drucial-dots
main   = "nvim ."

[Agent Kit]
path   = ~/Dev/agent-kit
main   = nvim
right  = claude
focus  = right

[Zen YouTube]
path   = ~/Dev/zen-youtube
main   = Claude
