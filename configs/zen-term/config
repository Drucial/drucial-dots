window-chrome = false
hide-toolbar-buttons = new-tab,split-h,split-v,bottom-drawer,right-drawer,scratch,focus-mode,command-palette,diff-viewer
backdrop-alpha = 0.7

cursor-style = block
cursor-style-blink = true
cursor-thickness = 3

keybind = clear_screen=none
keybind = diff_viewer=cmd+shift+g
keybind = fill_screen=cmd+shift+f
keybind = nav_down=ctrl+j
keybind = nav_left=ctrl+h
keybind = nav_right=ctrl+l
keybind = nav_up=ctrl+k
keybind = resize_down=cmd+ctrl+j
keybind = resize_left=cmd+ctrl+h
keybind = resize_right=cmd+ctrl+l
keybind = resize_up=cmd+ctrl+k
keybind = search_selection=none
keybind = toggle_focus_mode=cmd+enter
background-alpha = 1
attention-toast = auto
completion-toast = auto
toast-duration = 5
accent-color = green
