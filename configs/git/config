[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = side-by-side line-numbers-on
	navigate = true
	syntax-theme = base16
	hyperlinks = true
	blame-format = "{author:<14} {timestamp:<13} {commit:<8}"

[delta "line-numbers-on"]
	line-numbers = true

[merge]
	conflictStyle = zdiff3
