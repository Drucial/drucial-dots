# Copy this file to `.secrets` (gitignored) and fill in real values.
# Sourced by .zshrc from ~/.config/zsh/.secrets — keep real keys out of git.

export OPENAI_API_KEY=
# Linear personal API keys are workspace-scoped: one var per workspace, read by
# linear-tui's `workspaces` config (configs/linear-tui/config.json). Don't
# export a bare LINEAR_API_KEY — it overrides the app's auth unconditionally.
export LINEAR_API_KEY_CRAFTWORK=
export LINEAR_API_KEY_ZENTERM=
