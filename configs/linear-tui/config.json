{
  "api_endpoint": "https://api.linear.app/graphql",
  "timeout": "30s",
  "page_size": 50,
  "cache_ttl": "5m0s",
  "search_debounce": "300ms",
  "log_file": "/Users/drucial/.linear-tui/app.log",
  "log_level": "warning",
  "theme": "rose_pine_moon",
  "density": "comfortable",
  "group_by": "status",
  "subgroup_by": "",
  "rounded_borders": true,
  "workspaces": [
    {
      "name": "Craftwork",
      "api_key_env": "LINEAR_API_KEY_CRAFTWORK"
    },
    {
      "name": "Zenterm",
      "api_key_env": "LINEAR_API_KEY_ZENTERM"
    }
  ],
  "default_workspace": "Zenterm",
  "agent_provider": "cursor",
  "agent_sandbox": "enabled",
  "agent_model": "",
  "agent_workspace": "",
  "keybindings": {
    "add_comment": "c",
    "copy_branch": "Y",
    "copy_id": "i",
    "copy_url": "y",
    "create_sub_issue": "N",
    "edit_labels": "T",
    "edit_title": "t",
    "open_github": "O",
    "set_cycle": "C",
    "set_parent": "P",
    "switch_workspace": "w",
    "tab_next": "]",
    "tab_prev": "[",
    "toggle_details_pane": "}",
    "toggle_expand_all": "e",
    "toggle_navigation_pane": "{"
  },
  "default_team": "",
  "default_project": ""
}
