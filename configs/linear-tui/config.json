{
  "log_file": "/Users/drucial/.linear-tui/app.log",
  "log_level": "debug",
  "theme": "rose_pine_moon",
  "group_by": "status",
  "sort_by": ["status", "priority"],
  "rounded_borders": true,
  "workspaces": [
    {
      "name": "Craftwork",
      "api_key_env": "LINEAR_API_KEY_CRAFTWORK"
    },
    {
      "name": "Zenterm",
      "api_key_env": "LINEAR_API_KEY_ZENTERM"
    },
    {
      "name": "CoHaus",
      "api_key_env": "LINEAR_API_KEY_COHAUS"
    },
    {
      "name": "Praxis Labs",
      "api_key_env": "LINEAR_API_KEY_PRAXIS_LABS"
    }
  ],
  "default_workspace": "Zenterm",
  "keybindings": {
    "add_comment": "c",
    "copy_branch": "Y",
    "copy_id": "i",
    "copy_url": "y",
    "create_sub_issue": "N",
    "edit_labels": "T",
    "edit_title": "t",
    "open_github": "O",
    "set_cycle": "C",
    "set_parent": "P",
    "switch_workspace": "w",
    "tab_next": "]",
    "tab_prev": "[",
    "toggle_details_pane": "}",
    "toggle_expand_all": "e",
    "toggle_navigation_pane": "{"
  }
}
