configs/zsh/secrets
configs/zsh/.secrets
.zcompdump
.zsh_history
.DS_Store
configs/zsh/.zcompdump

# rainfrog: track the .example, keep the real config (DB connection details) local
configs/rainfrog/rainfrog_config.toml

# `omarchy refresh` and our own pre-edit backups drop these next to the file
# they copy. configs/hypr is ~/.config/hypr, so they land inside the repo.
*.bak.*

# btop resolves its Omarchy theme through a symlink into ~/.local/state, which
# bin/sync-omarchy recreates. Machine-specific, so it is not tracked.
configs/btop/themes/

# git: track the .example, keep identity and credential helpers local
configs/git/config.local

# lazygit: settings.yml is tracked, config.yml is generated from it by
# configs/lazygit/lazygit-theme with colours read from the terminal itself.
configs/lazygit/config.yml

# lazydocker: settings.yml is tracked, config.yml is generated from it by
# configs/lazydocker/lazydocker-theme with colours read from the terminal itself.
configs/lazydocker/config.yml
